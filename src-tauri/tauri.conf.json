{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctrl-CCCC",
  "version": "0.1.0",
  "identifier": "io.github.lin.ctrl-cccc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ctrl-CCCC",
        "url": "main.html",
        "width": 420,
        "height": 520,
        "visible": false,
        "center": true,
        "resizable": false,
        "skipTaskbar": false,
        "focus": true,
        "decorations": true
      },
      {
        "label": "toast",
        "title": "Ctrl-CCCC",
        "url": "index.html",
        "width": 380,
        "height": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "center": false,
        "dragDropEnabled": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
