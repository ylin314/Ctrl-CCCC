{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctrl-CCCC",
  "version": "0.2.1",
  "identifier": "cn.ylin314.ctrl-cccc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ctrl-CCCC",
        "url": "main.html",
        "width": 460,
        "height": 640,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "focus": true,
        "decorations": true,
        "resizable": true,
        "minWidth": 460,
        "minHeight": 640
      },
      {
        "label": "toast",
        "title": "Ctrl-CCCC",
        "url": "index.html",
        "width": 380,
        "height": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "center": false,
        "dragDropEnabled": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
